    <script>
        // Filter Kategori Navigasi
        function filterSection(category, btnElement) {
            const buttons = document.querySelectorAll('.nav-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            btnElement.classList.add('active');

            const sections = document.querySelectorAll('.section-block');
            sections.forEach(sec => {
                if (category === 'all' || sec.getAttribute('data-category') === category) {
                    sec.classList.remove('hidden');
                } else {
                    sec.classList.add('hidden');
                }
            });

            // Sembunyikan bar sorot kilometer jika hanya membuka tab Catatan Penting
            const kmBar = document.getElementById('km-highlighter');
            if (category === 'catatan') {
                kmBar.classList.add('hidden');
            } else {
                kmBar.classList.remove('hidden');
            }
        }

        // Sorot Kolom Interval Kilometer pada Kedua Tabel
        function highlightCol(colIndex, btnElement) {
            const buttons = document.querySelectorAll('.km-filter-btn');
            buttons.forEach(btn => btn.classList.remove('active-col'));
            btnElement.classList.add('active-col');

            // Hapus sorotan sebelumnya
            document.querySelectorAll('th[data-col], td[data-col]').forEach(cell => {
                cell.classList.remove('col-highlighted');
            });

            // Terapkan sorotan ke kolom yang dipilih
            if (colIndex > 0) {
                document.querySelectorAll(`th[data-col="${colIndex}"], td[data-col="${colIndex}"]`).forEach(cell => {
                    cell.classList.add('col-highlighted');
                });
            }
        }
    </script>
